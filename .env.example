# PostgreSQL (usado por Docker Compose)
POSTGRES_DB=memora
POSTGRES_USER=memora_user
POSTGRES_PASSWORD=cambiar_en_produccion

# Conexión de la aplicación a PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/memora
DB_USERNAME=memora_user
DB_PASSWORD=cambiar_en_produccion

# JPA/Hibernate
DDL_AUTO=update
SHOW_SQL=true

# Servidor de la aplicación
SERVER_PORT=8080

# Credenciales del administrador inicial
ADMIN_EMAIL=admin@memora.local
ADMIN_PASSWORD=cambiar_en_produccion

# JWT (secret mínimo 256 bits recomendado para HS256)
JWT_SECRET=cambiar_este_secreto_por_un_valor_largo_y_aleatorio_de_al_menos_32_caracteres
JWT_ACCESS_TTL=900000
JWT_REFRESH_TTL=2592000000
